
/* ===== Wersja 4: ciemny motyw narzędziowy, zakładki u góry (styl aplikacji typu live-audio multi-tool) ===== */
:root:root:root {
  --bg: #111418; --card: #1A1D24; --label: #E8EAED; --label-2: rgba(232,234,237,.62); --label-3: rgba(232,234,237,.32);
  --sep: rgba(255,255,255,.10); --fill: rgba(255,255,255,.06); --fill-strong: rgba(255,255,255,.13);
  --accent: #29A8E0; --accent-text: #4DBBEE; --on-accent: #06121A; --orange: #FFB454; --green: #4CD18A;
  --a: #29A8E0; --b: #FFA032; --b-text: #FFB454; --bar: #161A20; --shadow: 0 0 0 .5px rgba(255,255,255,.06);
  --r-card: 16px; --r-ctl: 10px; color-scheme: dark;
}
body { padding-block: 60px 28px; }
h1 { font-size: 24px; line-height: 30px; padding: 14px 0 6px; letter-spacing: -.01em; }
.tabbar { top: 0; bottom: auto; border-top: 0; border-bottom: .5px solid var(--sep); padding: 0 max(8px, env(safe-area-inset-left, 0px)); padding-top: env(safe-area-inset-top, 0px); background: var(--bar); -webkit-backdrop-filter: none; backdrop-filter: none; }
.tabbar .in { max-width: 560px; }
.tab { min-height: 48px; padding: 0; font: 700 16px/20px var(--font); position: relative; display: block; }
.tab svg { display: none; }
.tab[aria-selected="true"]::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; border-radius: 2px 2px 0 0; background: var(--accent); }
.btn { text-transform: uppercase; font-weight: 800; letter-spacing: .01em; border-radius: 14px; padding: 15px; }
.seg input:checked + span, :root:root .seg input:checked + span { background: var(--accent); color: var(--on-accent); box-shadow: none; font-weight: 700; }
.tile.on { background: var(--accent); }
#tileB.on { background: var(--b); }
.tile.on .who, .tile.on .hint, .tile.on .val { color: var(--on-accent); }
.group-title { letter-spacing: .06em; }
.badge { color: var(--on-accent); }
.pl-chipt.onA, .pl-chipt.onB, .pl-bl.onA, .pl-bl.onB { fill: #06121A; }
.pl-ref { fill: var(--label-2); }
.stage { background: var(--card); box-shadow: none; }
